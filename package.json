{
  "name": "hackert-ui",
  "version": "1.0.0",
  "private": true,
  "description": "Hackert UI monorepo",
  "keywords": [],
  "license": "MIT",
  "author": "tolu-c",
  "type": "module",
  "scripts": {
    "build:packages": "pnpm --filter \"./packages/*\" run build",
    "build:playground": "pnpm --filter playground build",
    "build": "pnpm build:packages && pnpm build:playground",
    "dev:packages": "pnpm --filter \"./packages/*\" --parallel exec vp pack --watch",
    "dev:playground": "pnpm --filter playground dev",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm --filter \"./packages/*\" --filter playground run test",
    "test:published": "node scripts/verify-published-packages.mjs",
    "lint": "vp check",
    "format": "vp check --fix",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --no-frozen-lockfile",
    "release": "pnpm build:packages && changeset publish",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:published",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "jsdom": "30.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "6.0.3",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "packageManager": "pnpm@11.22.0"
}
