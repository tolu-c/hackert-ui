{
  "name": "@hackert-ui/utils",
  "version": "0.0.0",
  "description": "Framework-agnostic utilities for Hackert UI",
  "keywords": [
    "typescript",
    "utils"
  ],
  "homepage": "https://github.com/tolu-c/hackert-ui/tree/main/packages/utils#readme",
  "bugs": {
    "url": "https://github.com/tolu-c/hackert-ui/issues"
  },
  "license": "MIT",
  "author": "tolu-c",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tolu-c/hackert-ui.git",
    "directory": "packages/utils"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vp test run --passWithNoTests"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  }
}
