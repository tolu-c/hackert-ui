{
  "name": "@hackert-ui/form",
  "version": "0.0.1",
  "description": "React form components for Hackert UI",
  "keywords": [
    "forms",
    "react",
    "ui"
  ],
  "homepage": "https://github.com/tolu-c/hackert-ui/tree/main/packages/form#readme",
  "bugs": {
    "url": "https://github.com/tolu-c/hackert-ui/issues"
  },
  "license": "MIT",
  "author": "tolu-c",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tolu-c/hackert-ui.git",
    "directory": "packages/form"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vp test run --passWithNoTests"
  },
  "devDependencies": {
    "react": "19.2.8"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}
